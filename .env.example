# ENDGAME - Round 1: THE MAINFRAME
# Copy to .env (server side) and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000

# Database - Supabase Postgres (production): transaction-mode pooler for runtime.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Optional session-mode connection used only for migrations:
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Local development uses an embedded Postgres (PGlite) data directory instead:
DATABASE_URL=./data/pg

# Public URL participants open after scanning a QR code (no trailing slash)
PUBLIC_BASE_URL=http://localhost:5173

# Allowed browser origin for the API (used by CORS + Socket.IO)
FRONTEND_URL=http://localhost:5173

# Absolute backend URL, used when generating join links
BACKEND_URL=http://localhost:4000

# Administrator credentials - required in production.
# If ADMIN_PASSWORD is left empty in development, a one-time password is printed to the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-the-event

# Round length in seconds (default 10 minutes)
ROUND_DURATION_SEC=600

# Session lifetime for participant and admin cookies
SESSION_TTL_HOURS=12

# Set to 1 only when running behind a trusted reverse proxy (nginx / caddy)
TRUST_PROXY=0
